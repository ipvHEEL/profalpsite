# Экономия памяти MySQL для VPS с 1 ГБ RAM.
# Путь на сервере: /etc/mysql/mysql.conf.d/zz-lowmem.cnf
# Откат: удалить этот файл и перезапустить mysql (systemctl restart mysql).
[mysqld]
performance_schema = OFF
innodb_buffer_pool_size = 64M
innodb_log_buffer_size = 8M
max_connections = 30
key_buffer_size = 8M
